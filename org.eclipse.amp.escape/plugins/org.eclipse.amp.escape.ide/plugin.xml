			name="Model Parameters">
		</editor>
		<editor class="org.eclipse.ui.editors.text.TextEditor" default="false"
			extensions="atest" icon="icons/test_file.gif" id="org.eclipse.amp.escape.ide.TestEditor"
			name="Model Test">
		</editor>
	</extension>-->
</plugin>

