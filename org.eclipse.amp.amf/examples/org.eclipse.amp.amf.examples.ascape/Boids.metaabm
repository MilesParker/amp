<?xml version="1.0" encoding="UTF-8"?>
<metaabm:SContext xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:act="http://metaabm.org/act" xmlns:metaabm="http://metaabm.org/structure" label="Boids Model" ID="boidsModel" pluralLabel="Boids Models">
  <attributes label="Boid Count" ID="boidCount" pluralLabel="Boid Counts" description="The number of boids to create." sType="INTEGER" defaultValue="20"/>
  <rootActivity xsi:type="act:AGroup" label="Root Act Group" ID="rootActGroup" pluralLabel="Root Act Groups">
    <members xsi:type="act:ABuild" label="Build Boids" ID="buildBoids" targets="//@rootActivity/@members[ID='createBoids']" selected="//@rootActivity/@members[ID='buildBoids']" agent="/" pluralLabel="Build Boidss"/>
    <members xsi:type="act:ACreateAgents" label="Create Boids" ID="createBoids" sources="//@rootActivity/@members[ID='buildBoids']" selected="//@rootActivity/@members[ID='buildBoids']" agent="//@agents[ID='boid']" agentCount="//@attributes[ID='boidCount']"/>
  </rootActivity>
  <implementation package="org.metaabm.examples.boids" className="BoidsModel" basePath=""/>
  <agents label="Boid" ID="boid" pluralLabel="Boids">
    <rootActivity xsi:type="act:AGroup" label="Root Act Group" ID="rootActGroup" pluralLabel="Root Act Groups">
      <members xsi:type="act:ARule" label="Boid Rule" ID="boidRule" targets="//@agents[ID='boid']/@rootActivity/@members[ID='boid']" selected="//@agents[ID='boid']/@rootActivity/@members[ID='boidRule']" agent="//@agents[ID='boid']" space="//@projections[ID='space2D']" pluralLabel="Boid Rules"/>
      <members xsi:type="act:ASelect" label="Boid" ID="boid" sources="//@agents[ID='boid']/@rootActivity/@members[ID='boidRule']" targets="//@agents[ID='boid']/@rootActivity/@members[ID='moveBoid']" selected="//@agents[ID='boid']/@rootActivity/@members[ID='boidRule']" agent="//@agents[ID='boid']" space="//@projections[ID='space2D']"/>
      <members xsi:type="act:AMove" label="Move Boid" ID="moveBoid" sources="//@agents[ID='boid']/@rootActivity/@members[ID='boid']" selected="//@agents[ID='boid']/@rootActivity/@members[ID='boidRule']" destination="//@agents[ID='boid']/@rootActivity/@members[ID='boid']"/>
    </rootActivity>
    <implementation className="Boid"/>
  </agents>
  <projections xsi:type="metaabm:SContinuousSpace" label="Space 2D" ID="space2D" pluralLabel="Space 2Ds" dimensionality="2">
    <attributes xsi:type="metaabm:SAttributeArray" label="Dimensions" ID="dimensions" pluralLabel="Dimensionss" description="The size of each dimension." sType="INTEGER" size="2"/>
    <attributes label="Width" ID="width" pluralLabel="Widths" description="The horizontal extent of the space." sType="INTEGER" defaultValue="10"/>
    <attributes label="Height" ID="height" pluralLabel="Heights" description="The vertical extent of the space." sType="INTEGER" defaultValue="10"/>
  </projections>
</metaabm:SContext>
