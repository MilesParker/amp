<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.0"?>

<plugin>

    <extension
            point="org.eclipse.ui.editors">
        <editor
              class="org.eclipse.amp.amf.parameters.AParExecutableExtensionFactory:org.eclipse.xtext.ui.core.editor.XtextEditor"
              contributorClass="org.eclipse.ui.editors.text.TextEditorActionContributor"
              default="true"
              extensions="apar"
              icon="icons/etool16/parameter_file.gif"
              id="org.eclipse.amp.amf.parameters.APar"
              name="APar Editor">
        </editor>
    </extension>
    <extension
        point="org.eclipse.ui.handlers">
        <handler
            class="org.eclipse.amp.amf.parameters.AParExecutableExtensionFactory:org.eclipse.xtext.ui.common.editor.hyperlinking.OpenDeclarationHandler"
            commandId="org.eclipse.xtext.ui.common.editor.hyperlinking.OpenDeclaration">
            <activeWhen>
                <reference
                    definitionId="org.eclipse.amp.amf.parameters.APar.Editor.opened">
                </reference>
            </activeWhen>
        </handler>
        <handler
            class="org.eclipse.amp.amf.parameters.AParExecutableExtensionFactory:org.eclipse.xtext.ui.core.editor.handler.ValidateActionHandler"
            commandId="org.eclipse.amp.amf.parameters.APar.validate">
         <activeWhen>
            <reference
                    definitionId="org.eclipse.amp.amf.parameters.APar.Editor.opened">
            </reference>
         </activeWhen>
      </handler>
    </extension>
    <extension point="org.eclipse.core.expressions.definitions">
        <definition id="org.eclipse.amp.amf.parameters.APar.Editor.opened">
            <and>
                <reference definitionId="isActiveEditorAnInstanceOfXtextEditor"/>
                <with variable="activeEditor">
                    <test property="org.eclipse.xtext.ui.core.editor.XtextEditor.languageName" 
                        value="org.eclipse.amp.amf.parameters.APar" 
                        forcePluginActivation="true"/>
                </with>        
            </and>
        </definition>
    </extension>
    <extension
            point="org.eclipse.ui.preferencePages">
        <page
            class="org.eclipse.amp.amf.parameters.AParExecutableExtensionFactory:org.eclipse.xtext.ui.core.editor.preferences.LanguageRootPreferencePage"
            id="org.eclipse.amp.amf.parameters.APar"
            name="APar"
            category="org.eclipse.xtext.languages">
            <keywordReference id="org.eclipse.amp.amf.parameters.ui.keyword_APar"/>
        </page>
        <page
            category="org.eclipse.amp.amf.parameters.APar"
            class="org.eclipse.amp.amf.parameters.AParExecutableExtensionFactory:org.eclipse.xtext.ui.common.editor.syntaxcoloring.SyntaxColoringPreferencePage"
            id="org.eclipse.amp.amf.parameters.APar.coloring"
            name="Syntax Coloring">
            <keywordReference id="org.eclipse.amp.amf.parameters.ui.keyword_APar"/>
        </page>
        <page
            category="org.eclipse.amp.amf.parameters.APar"
            class="org.eclipse.amp.amf.parameters.AParExecutableExtensionFactory:org.eclipse.xtext.ui.common.editor.templates.XtextTemplatePreferencePage"
            id="org.eclipse.amp.amf.parameters.APar.templates"
            name="Templates">
            <keywordReference id="org.eclipse.amp.amf.parameters.ui.keyword_APar"/>
        </page>
    </extension>
    <extension
        point="org.eclipse.ui.keywords">
        <keyword
            id="org.eclipse.amp.amf.parameters.ui.keyword_APar"
            label="APar"/>
    </extension>
    <extension
         point="org.eclipse.ui.commands">
      <command
            description="Trigger expensive validation"
            id="org.eclipse.amp.amf.parameters.APar.validate"
            name="Validate">
      </command>
    </extension>
    <extension point="org.eclipse.ui.menus">
        <menuContribution
            locationURI="popup:#TextEditorContext?after=group.open">
             <command
                 commandId="org.eclipse.amp.amf.parameters.APar.validate"
                 style="push"
                 tooltip="Trigger expensive validation">
            <visibleWhen checkEnabled="false">
                <reference
                    definitionId="org.eclipse.amp.amf.parameters.APar.Editor.opened">
                </reference>
            </visibleWhen>
         </command>  
         </menuContribution>
    </extension>

<!-- adding resource factories -->

	<extension
		point="org.eclipse.emf.ecore.extension_parser">
		<parser
			class="org.eclipse.amp.amf.parameters.AParExecutableExtensionFactory:org.eclipse.xtext.resource.XtextResourceFactory"
			type="apar">
		</parser>
	</extension>




</plugin>
