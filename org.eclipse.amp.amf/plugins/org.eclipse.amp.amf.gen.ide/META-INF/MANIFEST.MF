Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %pluginName
Bundle-SymbolicName: org.eclipse.amp.amf.gen.ide;singleton:=true
Bundle-Version: 0.2.0.qualifier
Bundle-Activator: org.eclipse.amp.amf.gen.ide.GenIDEPlugin$Implementation
Bundle-Vendor: %providerName
Require-Bundle: org.eclipse.core.resources,
 org.eclipse.core.runtime,
 org.eclipse.ui,
 org.eclipse.emf.mwe.core;bundle-version="0.7.0",
 org.eclipse.jdt.core,
 org.eclipse.emf.common.ui;bundle-version="2.5.0",
 org.eclipse.ui.ide;bundle-version="3.5.0",
 org.eclipse.xtend;bundle-version="0.7.0",
 org.eclipse.xtend.typesystem.emf;bundle-version="0.7.0",
 org.eclipse.amp.amf.gen;bundle-version="0.2.0"
Bundle-RequiredExecutionEnvironment: J2SE-1.5
Bundle-ActivationPolicy: lazy
Bundle-ClassPath: .
Export-Package: org.eclipse.amp.amf.gen.ide,
 org.eclipse.amp.amf.gen.ide.prefs
Import-Package: org.apache.commons.lang,
 org.apache.commons.logging
Bundle-Localization: plugin
