«DEFINE ProviderInstance(String providerType) FOR SAgent»
    «IF styles.size > 0-»
        if (agent instanceof «implementation.className») {
            return «styles.get(0).implementation.qualifiedName»«providerType».getDefault();
        }
    «ENDIF-»
«ENDDEFINE»
«DEFINE RecurseAgentProviders(String providerType) FOR SAgent-»
