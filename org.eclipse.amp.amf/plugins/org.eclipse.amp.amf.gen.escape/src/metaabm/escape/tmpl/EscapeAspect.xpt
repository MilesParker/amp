    «ENDIF-»
    «agent.id()»NewColor = dummyGraphics.getForegroundColor();
    if («agent.id()»NewColor == «agent.id()»LastColor) {
    	«agent.id()»NewColor = org.ascape.util.vis.ColorFeatureConcrete.createHSB((float) java.lang.Math.random() * 360f, 1.0f, 0.8f);
   	} else {
   		«agent.id()»LastColor = «agent.id()»NewColor;
   	}
	chart.addSeries("Count «agent.typeName()» «((List) setter).first()»", «agent.id()»NewColor);
    «ENDFOREACH-»
