«AROUND metaabm::tmpl::Java::MethodPotential (metaabm::act::AAct within) FOR FFunction-»
	«IF (id() == "withinBoundaries") || (id() == "distance")-»
		«EXPAND metaabm::tmpl::Java::Method-»
