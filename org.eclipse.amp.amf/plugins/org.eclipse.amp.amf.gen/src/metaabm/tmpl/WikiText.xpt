«IMPORT metaabm»
«IMPORT metaabm::act»
«IMPORT metaabm::function»

«EXTENSION metaabm::tmpl::infer» 
«EXTENSION metaabm::tmpl::util»
«EXTENSION metaabm::tmpl::names»
«EXTENSION metaabm::tmpl::types»
«EXTENSION metaabm::tmpl::projections»

«DEFINE Usage FOR FOperator-»
«IF arity==0-»
«symbol»
«ELSEIF arity==1-»
«symbol»X
«ELSEIF arity==2-»
X«symbol»Y
«ENDIF-»
«ENDDEFINE»

«DEFINE Usage FOR FGenericFunction-»«IF outputPrototypes.size > 0-»«outputPrototypes.get(0).typeName()» = «id()»(«FOREACH inputPrototypes AS input SEPARATOR ","»«input.typeName()»«ENDFOREACH»)
«ELSE-»«id()»(«FOREACH inputPrototypes AS input»«input.typeName()»«ENDFOREACH»)«ENDIF-»«ENDDEFINE»

«DEFINE Usage FOR FFunction-»(#)«ENDDEFINE»

«DEFINE LibraryTable FOR FLibrary-»
	«IF !subs.isEmpty-»
		«FOREACH subs AS sub-»
|-
|colspan="3" style="color:white; background-color:black;" | «sub.label»
			«EXPAND LibraryTable FOR sub-»
		«ENDFOREACH-»
	«ENDIF-»
	«IF !functions.isEmpty-»
	«FOREACH functions AS function-»
|-
| «function.label» 
| «EXPAND Usage FOR function» 
| «function.descrText().replaceAll("\r\n","")»
	«ENDFOREACH-»
	«ENDIF-»
«ENDDEFINE»
«DEFINE LibraryTable FOR IArtifact-»
«ENDDEFINE»

«DEFINE LibraryTable FOR SContext-»
«IF !library.isEmpty»
==Function Library==
{| border="1" cellpadding="2" cellspacing="0"
|-
! Name !! Usage !! Description
	«EXPAND LibraryTable FOREACH library-»
|}
«ENDIF-»
«ENDDEFINE»

«DEFINE Model FOR SContext-»
	«FILE ("doc/" + implementation.className + ".mediawiki") -»
		«EXPAND LibraryTable-»
	«ENDFILE»
«ENDDEFINE»