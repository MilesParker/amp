  <attributes label="True" ID="true" pluralLabel="Truth" defaultValue="true" immutable="true"/>
  <attributes label="False" ID="false" pluralLabel="Falses" description="" defaultValue="false" immutable="true"/>
  <attributes label="Zero" ID="zero" pluralLabel="Zeros" description="The value 0." sType="INTEGER" defaultValue="0" units="" immutable="true"/>
  <attributes label="Unit" ID="unit" pluralLabel="Units" description="The unit value, e.g. 1." sType="INTEGER" defaultValue="1" immutable="true"/>
