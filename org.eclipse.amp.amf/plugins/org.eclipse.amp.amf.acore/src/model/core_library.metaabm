        <functions xsi:type="function:FOperator" label="Zero Value" ID="zero" pluralLabel="Zero Values" description="The value of no units, e.g. zero." symbol="0"/>
        <functions xsi:type="function:FOperator" label="Original Value" ID="original" pluralLabel="Original Values" description="The original value, e.g. the value for the value client at time 0." symbol="o"/>
