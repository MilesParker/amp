Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %pluginName
Bundle-Vendor: %providerName
Bundle-Version: 0.2.0
Bundle-SymbolicName: org.eclipse.amp.amf.parameters; singleton:=true
Eclipse-RegisterBuddy: org.eclipse.xtext.log4j
Bundle-ActivationPolicy: lazy
Require-Bundle: org.eclipse.xtext,
 org.eclipse.xtext.generator;resolution:=optional,
 de.itemis.xtext.antlr;resolution:=optional,
 org.eclipse.emf.codegen.ecore;resolution:=optional,
 org.eclipse.emf.mwe.utils;resolution:=optional,
 org.eclipse.emf.mwe.core;resolution:=optional,
 org.eclipse.xtext.xtend;resolution:=optional,
 org.eclipse.xtext.util,
 org.eclipse.emf.ecore,
 org.eclipse.emf.common,
 org.antlr.runtime,
 org.eclipse.amp.amf.acore;bundle-version="0.2.0",
 org.eclipse.ui;bundle-version="3.5.0",
 org.eclipse.core.runtime;bundle-version="3.5.0",
 org.eclipse.core.resources;bundle-version="3.5.0",
 org.apache.log4j
Bundle-RequiredExecutionEnvironment: J2SE-1.5
Export-Package: org.eclipse.amp.amf.parameters;uses:="org.eclipse.xtext,org.eclipse.xtext.service,com.google.inject",
 org.eclipse.amp.amf.parameters.aPar;uses:="org.eclipse.emf.ecore,org.eclipse.emf.common.util,org.metaabm",
 org.eclipse.amp.amf.parameters.aPar.impl;
  uses:="org.eclipse.emf.ecore,
   org.eclipse.emf.common.util,
   org.metaabm,
   org.eclipse.amp.amf.parameters.aPar,
   org.eclipse.emf.ecore.impl,
   org.eclipse.emf.common.notify",
 org.eclipse.amp.amf.parameters.aPar.util;
  uses:="org.eclipse.emf.ecore,
   org.eclipse.emf.common.notify.impl,
   org.eclipse.amp.amf.parameters.aPar,
   org.eclipse.emf.common.notify",
 org.eclipse.amp.amf.parameters.formatting;uses:="org.eclipse.xtext.formatting.impl",
 org.eclipse.amp.amf.parameters.parseTreeConstruction;
  uses:="org.eclipse.xtext,
   org.eclipse.xtext.parsetree.reconstr,
   org.eclipse.xtext.parsetree.reconstr.impl,
   org.eclipse.amp.amf.parameters.services",
 org.eclipse.amp.amf.parameters.parser.antlr;
  uses:="org.eclipse.xtext.parser,
   org.antlr.runtime,
   org.eclipse.xtext.parser.antlr,
   org.eclipse.amp.amf.parameters.services",
 org.eclipse.amp.amf.parameters.parser.antlr.internal;
  uses:="org.eclipse.emf.ecore,
   org.eclipse.xtext.parser,
   org.eclipse.emf.common.util,
   org.antlr.runtime,
   org.eclipse.xtext.parser.antlr,
   org.eclipse.amp.amf.parameters.services",
 org.eclipse.amp.amf.parameters.scoping;uses:="org.eclipse.emf.ecore,org.eclipse.xtext.scoping,org.eclipse.xtext.scoping.impl",
 org.eclipse.amp.amf.parameters.services;uses:="org.eclipse.xtext,org.eclipse.xtext.common.services,org.eclipse.xtext.service",
 org.eclipse.amp.amf.parameters.validation;uses:="org.eclipse.xtext.validation"
Bundle-ClassPath: .
Import-Package: org.apache.commons.collections,
 org.apache.commons.lang

