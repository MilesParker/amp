<plugin>

   <extension point="org.eclipse.ui.newWizards">
      <category
            id="org.eclipse.emf.ecore.Wizard.category.ID"
            name="%_UI_Wizard_category"/>
      <wizard
            id="org.eclipse.amp.amf.testing.ares.presentation.AresModelWizardID"
            name="%_UI_AresModelWizard_label"
            class="org.eclipse.amp.amf.testing.ares.presentation.AresModelWizard"
            category="org.eclipse.emf.ecore.Wizard.category.ID"
            icon="icons/full/obj16/AresModelFile.gif">
         <description>%_UI_AresModelWizard_description</description>
         <selection class="org.eclipse.core.resources.IResource"/>
      </wizard>
   </extension>

   <extension point="org.eclipse.ui.editors">
      <editor
            id="org.eclipse.amp.amf.testing.ares.presentation.AresEditorID"
            name="%_UI_AresEditor_label"
            icon="icons/full/obj16/AresModelFile.gif"
            extensions="ares"
            class="org.eclipse.amp.amf.testing.ares.presentation.AresEditor"
            contributorClass="org.eclipse.amp.amf.testing.ares.presentation.AresActionBarContributor">
      </editor>
   </extension>

</plugin>
