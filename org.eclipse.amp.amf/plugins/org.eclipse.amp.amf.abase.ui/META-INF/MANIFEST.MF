Export-Package: org.eclipse.amp.amf.abase.contentassist,
 org.eclipse.amp.amf.abase.contentassist.antlr
Bundle-Activator: org.eclipse.amp.amf.abase.internal.ABaseActivator
Bundle-ClassPath: .
Bundle-Localization: plugin
