<plugin>
   <extension
         point="org.eclipse.ui.views">
     <view
           allowMultiple="true"
           category="org.eclipse.amp.axf.views"
           class="org.eclipse.amp.agf.gef.GEFViewPart"
           icon="icons/etool16/members.gif"
           id="org.eclipse.amp.view.GEFView"
           name="2D Agents"
           restorable="true">
     </view>
     <view
           allowMultiple="true"
           category="org.eclipse.amp.axf.views"
           class="org.eclipse.amp.agf.tree.TreeViewPart"
           icon="icons/etool16/tree_view.gif"
           id="org.eclipse.amp.view.TreeView"
           name="Agent Navigator"
           restorable="true">
     </view>
   </extension>
   <extension
         point="org.eclipse.core.runtime.adapters">
      <factory
            adaptableType="org.eclipse.amp.axf.core.IModel"
            class="org.eclipse.amp.agf.GraphicsAdapterFactory">
         <adapter
               type="org.eclipse.jface.viewers.ILabelProvider">
         </adapter>
         <adapter
               type="org.eclipse.jface.viewers.IColorProvider">
         </adapter>
      </factory>
   </extension>


</plugin>

